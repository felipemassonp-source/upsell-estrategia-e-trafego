rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'felipemassonp@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Startup connection validation
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // UpSell Clients Collection
    match /clients/{clientId} {
      // allow get on individual client doc with id check; allow list on collection
      allow get: if isValidId(clientId);
      allow list: if true;
      allow create, update: if isValidId(clientId);
      allow delete: if isValidId(clientId);
    }

    // Admins Collection
    match /admins/{uid} {
      allow get: if isSignedIn() && isValidId(uid);
      allow list: if isBootstrappedAdmin();
      allow write: if isBootstrappedAdmin() && isValidId(uid);
    }
  }
}
